# Cartograph Environment Configuration
# Copy to .env and fill in your values

# Application
APP_NAME=Cartograph
DEBUG=false
PORT=8080
FRONTEND_URL=http://localhost:3000

# Database (Cloud SQL or AlloyDB with pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cartograph
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/cartograph

# Google Cloud
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCS_BUCKET_NAME=cartograph-uploads

# Vertex AI
VERTEX_AI_MODEL=gemini-2.0-flash
VERTEX_AI_EMBEDDING_MODEL=text-embedding-005
EMBEDDING_DIMENSION=768

# Ingestion limits
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Similarity thresholds
SIMILARITY_ALPHA=0.6
SIMILARITY_BETA=0.4
